# Google Apps Script Web App URL
VITE_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_CONFIRMATION_TEMPLATE=template_confirmation

# Admin email for booking notifications (Jen's email address)
# When set, a notification is sent to this address on every new booking via the template_admin_notification EmailJS template
VITE_ADMIN_EMAIL=
